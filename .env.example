# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual API keys.
# .env is in .gitignore and should NEVER be committed to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Required for live LLM generation. Without this, the system runs in mock mode.
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=4096
# Base URL for the OpenAI-compatible chat completions API. Defaults to
# Google's Gemini OpenAI-compatibility endpoint (set OPENAI_API_KEY to a
# Gemini key and OPENAI_MODEL to a gemini-* model name to use it that way).
# Set to an empty string to call the real OpenAI API instead.
OPENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/

# ── Tavily Search ─────────────────────────────────────────────────────────────
# Get your key at: https://tavily.com
# Without this, mock search results are used.
TAVILY_API_KEY=tvly-your-tavily-api-key-here
TAVILY_MAX_RESULTS=5

# ── ArXiv (Academic Researcher agent) ─────────────────────────────────────────
# arXiv's public search API is free and keyless — leave this empty to use it
# as-is. The Academic Researcher agent (which searches arXiv and produces
# citations for academic/research-heavy topics) works fine without a key.
# Only fill this in if you have a key for an arXiv-adjacent service.
ARXIV_API_KEY=
ARXIV_MAX_RESULTS=5

# ── Langfuse Observability ───────────────────────────────────────────────────
# Get your keys at: https://cloud.langfuse.com (or self-host)
# Without these, tracing is silently disabled.
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Redis / Celery (for API mode with background tasks) ──────────────────────
# Required only when running in API mode with Celery.
# For local testing, the in-memory FastAPI BackgroundTasks are used instead.
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Application Settings ──────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_TRACING=true
# Local subprocess sandbox used by the Critic agent to run/plot code snippets.
ENABLE_CODE_SANDBOX=true
ENABLE_HITL=true

# ── AgentLens mock / Trace Explorer ──────────────────────────────────────────
# SQLite for runs, events, local observations (bind-mount ./data in Docker).
DATA_DIR=data
# Comma-separated browser origins. Never use * in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173
# Wall-clock timeout around graph.invoke (seconds).
GRAPH_TIMEOUT_SECONDS=600
# If false, GET /api/v1/runs/{id}/trace/raw is I/O-redacted unless ADMIN_TOKEN is sent.
ENABLE_RAW_TRACE_PUBLIC=false
# Bearer token for GET /api/v1/runs/{id}/ground-truth (eval only). Leave empty to disable.
ADMIN_TOKEN=
# POST rate limit per client IP.
RATE_LIMIT_PER_MIN=60
